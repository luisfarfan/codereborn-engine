  tier: "standard",  // Default tier del usuario
  created_at: "2024-01-01T00:00:00Z"
}
```

### Jobs State
```javascript
{
  list: [...],  // Array de Jobs
  current: {...},  // Job actual en detalle
  filters: {
    status: null,
    repo: null,
    scope: null,
    tier: null,
    startDate: null,
    endDate: null
  },
  pagination: {
    page: 1,
    pageSize: 20,
    total: 42
  }
}
```

### Agents State
```javascript
{
  available: [...],  // Array de agentes disponibles
  tiers: [...],  // Array de tiers con configuraciones
  loading: false,
  error: null
}
```

### Real-time State (para Job en ejecución)
```javascript
{
  connected: true,
  jobId: "uuid-1234",
  agents: [...],  // Estado actual de cada agente
  activeAgent: {...},  // Agente actualmente ejecutándose
  streamedOutput: "...",  // Output en streaming
  communications: [...],  // Comunicaciones entre agentes
  elapsed: 745  // Segundos transcurridos
}
```

