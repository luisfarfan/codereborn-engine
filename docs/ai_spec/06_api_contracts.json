    {
      "id": 6,
      "name": "Guided Intelligence Tools",
      "description": "LLM-powered tools that guide technical decisions without modifying code. MUST call LLMBudgetService before any inference. Will return 402 if budget is exhausted.",
      "llm_gated": true,
      "endpoints": [
        {
          "id": "suggest_implementation_approach",
          "method": "POST",
          "path": "/jobs/{job_id}/suggest-implementation-approach",
          "description": "Suggest how to implement a feature respecting existing architecture.",
          "request_body": {
            "feature_description": { "type": "str", "required": true }
          },
          "response_fields": {
            "feature_description": { "type": "str" },
            "suggested_approach": { "type": "str" },
            "files_to_create": { "type": "list[RecommendedFile]" },
            "files_to_modify": { "type": "list[RecommendedFile]" },
            "patterns_to_follow": { "type": "list[str]" },
            "risks": { "type": "list[str]" },
            "llm_decision": { "type": "LLMCallDecision" }
          }
        },
        {
          "id": "suggest_refactor_strategy",
          "method": "POST",
          "path": "/jobs/{job_id}/suggest-refactor-strategy",
          "request_body": {
            "refactor_goal": { "type": "str", "required": true }
          },
          "response_fields": {
            "refactor_goal": { "type": "str" },
            "strategy": { "type": "str" },
            "phases": { "type": "list[RefactorPhase]" },
            "estimated_effort": { "type": "str" },
            "risks": { "type": "list[str]" },
            "llm_decision": { "type": "LLMCallDecision" }
          }
        },
        {
          "id": "suggest_debugging_entry_points",
          "method": "POST",
          "path": "/jobs/{job_id}/suggest-debugging-entry-points",
          "request_body": {
            "bug_description": { "type": "str", "required": true }
          },
