            "metadata": { "type": "DocArtifactMetadata" }
          }
        },
        {
          "id": "get_module_documentation",
          "method": "POST",
          "path": "/jobs/{job_id}/get-module-documentation",
          "request_body": {
            "module_name": { "type": "str", "required": true }
